// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum Role {
  USER
  ADMIN
}

enum SignalDirection {
  BUY
  SELL
}

enum SignalStatus {
  ACTIVE
  HIT_TP1
  HIT_TP2
  HIT_SL
  CANCELLED
}

enum TradeOutcome {
  OPEN
  WIN
  LOSS
  BREAKEVEN
}

enum TradingSession {
  NEW_YORK
  LONDON
  ASIA
}

// ==========================================
// MÓDULO 1: AUTENTICACIÓN Y USUARIOS (NextAuth + Custom)
// ==========================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?   // Opcional porque usuarios de Google SSO no tienen password local
  image         String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true) // Toggle en /admin/users para activar/desactivar acceso
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relaciones NextAuth
  accounts      Account[]
  sessions      Session[]

  // Relaciones de Negocio
  subscriptions StrategySubscription[]
  journal       JournalEntry[]

  @@index([email])
  @@index([role, isActive])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// MÓDULO 2: MOTOR DE ESTRATEGIAS Y SEÑALES
// ==========================================

model Strategy {
  id          String   @id @default(cuid())
  name        String   @unique // Ej: "Rechazo de Liquidez M15"
  description String   @db.Text
  winRate     Decimal  @db.Decimal(5, 2) // Ej: 74.50 (%)
  timeframe   String?  // Ej: "M15", "H1"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relaciones
  signals     Signal[]
  subscribers StrategySubscription[]
}

// Tabla pivote explícita para la suscripción (filtro del feed del usuario)
model StrategySubscription {
  id           String   @id @default(cuid())
  userId       String
  strategyId   String
  subscribedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategy Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([userId, strategyId])
  @@index([userId])
  @@index([strategyId])
}

model Signal {
  id           String          @id @default(cuid())
  strategyId   String
  asset        String          @default("XAU/USD") // Ej: "XAU/USD", "US30", "NAS100"
  direction    SignalDirection // BUY o SELL
  entryPrice   Decimal         @db.Decimal(12, 4) // Precio o límite inferior de zona
  entryZoneMax Decimal?        @db.Decimal(12, 4) // Opcional para rango (Ej: 4152.50 - 4155.00)
  stopLoss     Decimal         @db.Decimal(12, 4)
  takeProfit1  Decimal         @db.Decimal(12, 4)
  takeProfit2  Decimal?        @db.Decimal(12, 4)
  status       SignalStatus    @default(ACTIVE)
  createdAt    DateTime        @default(now())
  closedAt     DateTime?

  // Relaciones
  strategy       Strategy       @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  journalEntries JournalEntry[]

  @@index([strategyId, status, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

// ==========================================
// MÓDULO 3: BITÁCORA RÁPIDA Y MÉTRICAS ESTÁNDAR (TRADING JOURNAL)
// ==========================================

model JournalEntry {
  id             String         @id @default(cuid())
  userId         String
  signalId       String
  outcome        TradeOutcome   @default(OPEN)      // WIN, LOSS, BREAKEVEN, OPEN
  lotSize         Decimal        @db.Decimal(8, 2)   // Ej: 0.25 lotes
  executionPrice  Decimal        @db.Decimal(12, 4)  // Precio real de entrada
  targetTpPrice   Decimal?       @db.Decimal(12, 4)  // Nivel de Take Profit objetivo del trader
  estimatedProfit Decimal        @db.Decimal(12, 2)  @default(0.00) // Ganancia estimada en USD si toca el TP objetivo
  exitPrice       Decimal?       @db.Decimal(12, 4)  // Precio real de cierre/salida
  riskAmount     Decimal        @db.Decimal(12, 2)  @default(100.00) // Riesgo monetario en USD (1R)
  pnlAmount      Decimal        @db.Decimal(12, 2)  @default(0.00)   // Ganancia (+) o Pérdida (-) neta en USD
  rMultiple      Decimal        @db.Decimal(6, 2)   @default(0.00)   // Ej: +2.50R, -1.00R
  session        TradingSession @default(NEW_YORK)  // NEW_YORK, LONDON, ASIA
  followedPlan   Boolean        @default(true)      // ¿Respetó reglas del plan?
  emotionState   String         @default("Disciplinado") // Estado psicológico
  emotionNote    String?        @db.Text            // Nota libre / lección aprendida
  signalSnapshot Json?                              // Copia inmutable de la señal original (Entrada, SL, TP1, TP2, Estrategia)
  isDeleted      Boolean        @default(false)     // En papelera (soft delete)
  deletedAt      DateTime?                          // Fecha de envío a la papelera
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relaciones
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@unique([userId, signalId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([signalId])
}
